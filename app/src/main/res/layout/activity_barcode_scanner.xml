<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- CameraX Preview Surface -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Dark overlay scrim (top) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="#AA000000" />

    <!-- Dark overlay scrim (bottom) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_gravity="bottom"
        android:background="#AA000000" />

    <!-- Scan Reticle Card -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="180dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_scanner_reticle"
        android:orientation="vertical" />

    <!-- UI Overlay -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="52dp"
            android:paddingBottom="16dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnCancelScan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕ CANCEL"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:padding="10dp"
                android:background="@drawable/bg_cancel_pill" />

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEUTRI SCAN"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1" />
        </LinearLayout>

        <!-- Spacer to push reticle hint to center area -->
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <!-- Hint text below reticle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Point at a barcode to scan"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:layout_marginTop="220dp" />

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <!-- Status chip at bottom -->
        <TextView
            android:id="@+id/tvScannerStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCANNING..."
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_status_chip"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:layout_marginBottom="60dp" />

    </LinearLayout>

</FrameLayout>
