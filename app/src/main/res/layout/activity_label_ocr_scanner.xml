<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brutal_yellow"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Navigation HUD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/btnBackOcr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neo_button_secondary"
            android:clickable="true"
            android:focusable="true"
            android:letterSpacing="0.08"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="← BACK"
            android:textColor="@color/nb_black"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:letterSpacing="0.06"
            android:text="PACK LABEL OCR SCANNER"
            android:textColor="@color/nb_black"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnToggleFlashOcr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neo_button_secondary"
            android:clickable="true"
            android:focusable="true"
            android:letterSpacing="0.08"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="FLASH OFF"
            android:textColor="@color/nb_black"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Camera Viewfinder Box -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        android:background="@drawable/bg_neo_card">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            android:background="@color/nb_black">

            <!-- CameraX Preview -->
            <androidx.camera.view.PreviewView
                android:id="@+id/ocrPreviewView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Reticle Overlay -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_gravity="center"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_neo_input">

                <TextView
                    android:id="@+id/tvOcrStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_neo_button_primary"
                    android:letterSpacing="0.06"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="ALIGN INGREDIENT LABEL"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOcrLiveSnippet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_margin="12dp"
                    android:background="#DD000000"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:padding="8dp"
                    android:text="Point camera at ingredients list or product title..."
                    android:textColor="@color/white"
                    android:textSize="11sp" />
            </FrameLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- Bottom Controls HUD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_neo_button_primary">

            <TextView
                android:id="@+id/btnCaptureLabelOcr"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="4dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:text="SCAN &amp; ANALYZE LABEL (OCR)"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
