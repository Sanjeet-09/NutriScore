<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nb_bg_cream"
    android:fitsSystemWindows="true"
    tools:context=".SplashActivity">

    <!-- Center Content Group (Minimal Neo-Brutalist: Hero + Typography) -->
    <LinearLayout
        android:id="@+id/llCenterContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/progressContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.46">

        <!-- Minimal Neo-Brutalist Hero Card -->
        <FrameLayout
            android:id="@+id/heroCard"
            android:layout_width="146dp"
            android:layout_height="146dp"
            android:background="@drawable/bg_neo_card"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <ImageView
                android:id="@+id/ivHeroEmblem"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_barcode_shield" />
        </FrameLayout>

        <!-- Brand Name: Minimalist Neo-Brutalist Typography -->
        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.06"
            android:text="@string/splash_app_title"
            android:textColor="@color/nb_black"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- Subtitle: High-Tracked Minimalist Tagline -->
        <TextView
            android:id="@+id/tvAppSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.18"
            android:text="@string/splash_app_subtitle"
            android:textColor="@color/nb_muted_gray"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Bottom Status & Minimalist Neo Progress Bar Container -->
    <LinearLayout
        android:id="@+id/progressContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="128dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Sleek Minimal Neo-Brutalist Progress Bar -->
        <ProgressBar
            android:id="@+id/splashProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="130dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_neo_progress_track"
            android:indeterminate="true"
            android:indeterminateTint="@color/nb_black"
            android:padding="1dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.16"
            android:text="@string/splash_status"
            android:textColor="@color/nb_muted_gray"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>