<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:left="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/nb_shadow" />
            <corners android:radius="100dp" />
        </shape>
    </item>

    <item
        android:bottom="3dp"
        android:right="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/nb_yellow" />
            <stroke
                android:width="2.5dp"
                android:color="@color/nb_border" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</layer-list>
